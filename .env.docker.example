POSTGRES_DB=dropss
POSTGRES_USER=dropss
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql+psycopg://dropss:replace_with_strong_password@db:5432/dropss

APP_PASSWORD=replace_with_strong_app_password
APP_SECRET_KEY=replace_with_long_random_secret
AUTH_ENABLED=true
APP_ENV=production
EXPOSE_DOCS=false
# Set true when served via HTTPS; enables Secure cookies and SameSite=Strict
AUTH_COOKIE_SECURE=false
OUTBOUND_ALLOWLIST=
LOG_LEVEL=INFO

FRONTEND_PORT=3000
BACKEND_PORT=8619

#For Development
# DEV_FRONTEND_PORT=8093
# DEV_BACKEND_PORT=8620
# DEV_DB_PORT=5433

BACKEND_IMAGE=beeetfarmer/dropss-backend:latest
FRONTEND_IMAGE=beeetfarmer/dropss-frontend:latest
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://backend:8619

SETTINGS_OVERRIDES_FILE=/data/settings_overrides.json
CORS_ORIGINS=http://localhost:3000,http://localhost:8093

# Integration credentials are environment-only (not persisted by UI)
# SPOTIFY_CLIENT_ID=

SPOTIFY_CLIENT_SECRET=

# GOTIFY_URL=
GOTIFY_TOKEN=

# NTFY_URL=
# NTFY_TOPIC=
# NTFY_USERNAME=
# NTFY_PASSWORD=

# Create a bot with @BotFather, message it once, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

LASTFM_API_KEY=
# LASTFM_USERNAME=

# JELLYFIN_URL=
JELLYFIN_API_KEY=

# PLEX_URL=
PLEX_TOKEN=

# NAVIDROME_URL=
# NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=

# RELEASE_CHECK_TIME=09:00
# TIMEZONE=UTC
# RELEASE_MONTHS_BACK=3
